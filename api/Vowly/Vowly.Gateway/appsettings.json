{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Vowly.Api",
    "Audience": "Vowly.Web"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "api",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "admin": {
        "ClusterId": "api",
        "Order": 2,
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/api/admin/{**catch-all}" }
      },
      "casal": {
        "ClusterId": "api",
        "Order": 3,
        "AuthorizationPolicy": "casal",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api-principal": { "Address": "http://127.0.0.1:5266/" }
        }
      }
    }
  }
}